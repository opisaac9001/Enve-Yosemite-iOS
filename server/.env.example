# Enve Yosemite companion server — copy to .env and fill in what you have.
# Every key is optional; feeds that need a missing key report state "unavailable".

PORT=8787
HOST=127.0.0.1
# Public base URL used in logs only (the app stores its own server address).
PUBLIC_BASE_URL=

# User agent sent to api.weather.gov (NWS asks for contact info).
NWS_USER_AGENT=enve-yosemite (your-email@example.com)

# NPS Developer API key — alerts, events, visitor centres, road events.
NPS_API_KEY=

# AirNow API key — current observations by lat/long.
AIRNOW_API_KEY=

# NASA FIRMS map key — VIIRS active-fire detections.
FIRMS_MAP_KEY=

# Caltrans CWWP2 chain-control JSON URL template; {district} is replaced by 6, 9 and 10.
CALTRANS_CC_URL_TEMPLATE=https://cwwp2.dot.ca.gov/data/d{district}/cwwp2_d{district}_cc.json

# Background refresh interval in minutes.
REFRESH_MINUTES=15

# APNs (token-based auth). Leave blank until you have credentials; the server reports pushReady=false.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_KEY_P8_PATH=
# Installed bundle ID, intentionally unchanged by the Enve Yosemite rename.
APNS_BUNDLE_ID=dev.petty.fieldguide
APNS_USE_SANDBOX=true

# Directory holding explorer packs and catalog.json (served under /data/explorer/).
EXPLORER_DIR=./public/data/explorer

# Data directory for cache, suggestions, push tokens and incident tracking.
DATA_DIR=./data
